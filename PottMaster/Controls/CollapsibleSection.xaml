<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PottMaster.Controls.CollapsibleSection"
             x:Name="this">
    <Border Style="{StaticResource CardBorderStyle}" Padding="0">
        <VerticalStackLayout Spacing="0">
            <!-- Header -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                    Padding="16,12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" 
                           Text="{Binding Source={x:Reference this}, Path=Title}"
                           FontSize="16"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>
                    <Image Grid.Column="1"
                           Source="{Binding Source={x:Reference this}, Path=IsExpanded, Converter={StaticResource BoolToExpandIconConverter}}"
                           WidthRequest="24"
                           HeightRequest="24"
                           VerticalOptions="Center"/>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={x:Reference this}, Path=ToggleCommand}"/>
                </Border.GestureRecognizers>
            </Border>

            <!-- Content -->
            <ContentPresenter Content="{Binding Source={x:Reference this}, Path=Content}"
                              IsVisible="{Binding Source={x:Reference this}, Path=IsExpanded}"
                              Padding="16"/>
        </VerticalStackLayout>
    </Border>
</ContentView>
