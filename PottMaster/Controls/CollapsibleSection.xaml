<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PottMaster.Controls.CollapsibleSection"
             x:Name="this">
    <Border Style="{StaticResource CardBorderStyle}" Padding="0">
        <VerticalStackLayout Spacing="0">
            <!-- Header -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                    Padding="16,12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" 
                           x:Name="TitleLabel"
                           FontSize="16"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>
                    <Label Grid.Column="1"
                           x:Name="ExpandIconLabel"
                           FontSize="20"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleCommand}"/>
                </Border.GestureRecognizers>
            </Border>

            <!-- Content -->
            <ContentPresenter x:Name="ContentPresenter"
                              Padding="16"/>
        </VerticalStackLayout>
    </Border>
</ContentView>
