<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PottMaster.Pages.GlazeInventoryPage"
             Title="Inventory">

    <Grid>
        <VerticalStackLayout Padding="24" 
                           Spacing="16"
                           VerticalOptions="Center"
                           HorizontalOptions="Center">
            <Label Text="Glaze Inventory"
                   Style="{StaticResource HeadlineLarge}"
                   HorizontalOptions="Center"/>
            <Label Text="Coming Soon"
                   Style="{StaticResource BodyLarge}"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"/>
            <Label Text="Track your glaze collection and link them to your ceramic works."
                   Style="{StaticResource BodyMedium}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,16,0,0"
                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"/>
        </VerticalStackLayout>
    </Grid>

</ContentPage>
