<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:PottMaster.Controls"
             xmlns:vm="clr-namespace:PottMaster.ViewModels"
             xmlns:converters="clr-namespace:PottMaster.Converters"
             x:Class="PottMaster.Pages.GlazeInventoryPage"
             x:DataType="vm:GlazeInventoryViewModel"
             Title="Inventory">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToStarIconConverter x:Key="BoolToStarIconConverter" />
            <converters:GlazeTypeIdToColorConverter x:Key="GlazeTypeIdToColorConverter" />
            <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Search and Filter Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="16" ColumnSpacing="8">
            <SearchBar Grid.Column="0" 
                       Placeholder="Search glazes..."
                       Text="{Binding SearchText}"
                       SearchCommand="{Binding LoadGlazesCommand}"/>
            <CheckBox Grid.Column="1" 
                      IsChecked="{Binding ShowFavoritesOnly}"
                      VerticalOptions="Center"/>
        </Grid>

        <!-- Glaze List -->
        <RefreshView Grid.Row="1" 
                     IsRefreshing="{Binding IsLoading}"
                     Command="{Binding LoadGlazesCommand}">
            <CollectionView ItemsSource="{Binding FilteredGlazes}"
                           SelectionMode="None"
                           EmptyView="No glazes found. Add your first glaze!">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Delete" 
                                               BackgroundColor="Red"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GlazeInventoryViewModel}}, Path=DeleteGlazeCommand}"
                                               CommandParameter="{Binding .}"/>
                                </SwipeItems>
                            </SwipeView.RightItems>
                            
                            <Border Padding="16" Margin="16,0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12">
                                    <!-- Favorite Star -->
                                    <Image Grid.Column="0" Grid.RowSpan="3"
                                           Source="{Binding IsFavorite, Converter={StaticResource BoolToStarIconConverter}}"
                                           WidthRequest="24" HeightRequest="24"
                                           VerticalOptions="Start">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GlazeInventoryViewModel}}, Path=ToggleFavoriteCommand}" 
                                                                 CommandParameter="{Binding .}"/>
                                        </Image.GestureRecognizers>
                                    </Image>
                                    
                                    <!-- Name & Manufacturer -->
                                    <Label Grid.Column="1" Grid.Row="0"
                                           Text="{Binding Name}"
                                           FontSize="16"
                                           FontAttributes="Bold"/>
                                    <Label Grid.Column="1" Grid.Row="1"
                                           Text="{Binding Manufacturer}"
                                           FontSize="12"
                                           Opacity="0.7"
                                           IsVisible="{Binding Manufacturer, Converter={StaticResource IsNotNullConverter}}"/>
                                    
                                    <!-- Quick Tags -->
                                    <HorizontalStackLayout Grid.Column="1" Grid.Row="2" Spacing="4">
                                        <Label Text="{Binding ConeRating}"
                                               FontSize="11"
                                               IsVisible="{Binding ConeRating, Converter={StaticResource IsNotNullConverter}}"/>
                                        <Label Text="•" FontSize="11" 
                                               IsVisible="{Binding Color, Converter={StaticResource IsNotNullConverter}}"/>
                                        <Label Text="{Binding Color}"
                                               FontSize="11"
                                               IsVisible="{Binding Color, Converter={StaticResource IsNotNullConverter}}"/>
                                    </HorizontalStackLayout>
                                    
                                    <!-- Quantity & Type -->
                                    <VerticalStackLayout Grid.Column="2" Grid.RowSpan="3"
                                                        VerticalOptions="Center"
                                                        Spacing="4">
                                        <Label Text="{Binding Quantity}" 
                                               FontSize="12"
                                               HorizontalOptions="End"
                                               IsVisible="{Binding Quantity, Converter={StaticResource IsNotNullConverter}}"/>
                                        <Border Padding="8,4"
                                                BackgroundColor="{Binding TypeId, Converter={StaticResource GlazeTypeIdToColorConverter}}"
                                                StrokeThickness="0"
                                                IsVisible="{Binding TypeId, Converter={StaticResource IsNotNullConverter}}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding TypeName}" 
                                                   FontSize="10"
                                                   TextColor="White"
                                                   FontAttributes="Bold"/>
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                                
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GlazeInventoryViewModel}}, Path=ViewGlazeDetailsCommand}"
                                                         CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- FAB for Adding New Glaze -->
        <Button Grid.Row="1" 
                Text="+"
                FontSize="32"
                WidthRequest="60"
                HeightRequest="60"
                CornerRadius="30"
                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                TextColor="White"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="16"
                Command="{Binding AddGlazeCommand}"/>

        <!-- Bottom Navigation Bar -->
        <controls:BottomNavigationBar Grid.Row="2" />
    </Grid>

</ContentPage>
