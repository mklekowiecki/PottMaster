<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PottMaster.ViewModels"
             xmlns:resx="clr-namespace:PottMaster.Resources"
             xmlns:converters="clr-namespace:PottMaster.Converters"
             xmlns:models="clr-namespace:PottMasterLib.Models;assembly=PottMasterLib"
             x:Class="PottMaster.Pages.WorkDetailPage"
             Title="{x:Static resx:AppResources.WorkDetails}"
             x:DataType="vm:WorkDetailViewModel">

    <ContentPage.Resources>
        <converters:SyncStatusCodeToLocalizedConverter x:Key="SyncStatusCodeToLocalizedConverter" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{x:Static resx:AppResources.Delete}"
                     Command="{Binding DeleteWorkCommand}"
                     IconImageSource="delete.png"/>
    </ContentPage.ToolbarItems>

    <Grid>
        <ActivityIndicator IsRunning="{Binding IsLoading}"
                         IsVisible="{Binding IsLoading}"
                         HeightRequest="50"
                         VerticalOptions="Center"
                         HorizontalOptions="Center"/>

        <ScrollView IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- Photo Gallery -->
                <CollectionView ItemsSource="{Binding Photos}"
                               HeightRequest="250"
                               IsVisible="{Binding HasPhotos}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:LocalPhoto">
                            <Border Style="{StaticResource CardStyle}"
                                   Padding="0"
                                   HeightRequest="250"
                                   WidthRequest="250">
                                <Image Source="{Binding Path, Converter={StaticResource StringToImageSourceConverter}}"
                                       Aspect="AspectFill"/>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Photo Placeholder -->
                <Border Style="{StaticResource CardStyle}"
                       BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceVariant}, Dark={StaticResource SurfaceVariantDark}}"
                       HeightRequest="250"
                       IsVisible="{Binding HasPhotos, Converter={StaticResource InvertedBoolConverter}}">
                    <VerticalStackLayout VerticalOptions="Center"
                                        HorizontalOptions="Center"
                                        Spacing="8">
                        <Label Text="📷"
                               FontSize="64"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="{x:Static resx:AppResources.NoPhoto}"
                               Style="{StaticResource BodyLarge}"
                               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Work Code Card (Elevated) -->
                <Border Style="{StaticResource ElevatedCardStyle}"
                       BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{x:Static resx:AppResources.WorkCode}"
                               Style="{StaticResource LabelMedium}"
                               TextColor="{AppThemeBinding Light={StaticResource OnPrimary}, Dark={StaticResource OnPrimaryDark}}"
                               Opacity="0.8"/>
                        <Label Text="{Binding CurrentWork.Code}"
                               Style="{StaticResource HeadlineMedium}"
                               TextColor="{AppThemeBinding Light={StaticResource OnPrimary}, Dark={StaticResource OnPrimaryDark}}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Info Grid -->
                <Grid RowDefinitions="Auto,Auto,Auto" 
                      ColumnDefinitions="*,*"
                      RowSpacing="12"
                      ColumnSpacing="12">

                    <!-- Category Card -->
                    <Border Grid.Row="0" Grid.Column="0"
                           Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{x:Static resx:AppResources.Category}"
                                   Style="{StaticResource LabelMedium}"/>
                            <Label Text="{Binding CurrentWork.CategoryCode, Converter={StaticResource WorkCategoryCodeToLocalizedConverter}}"
                                   Style="{StaticResource TitleMedium}"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Status Card -->
                    <Border Grid.Row="0" Grid.Column="1"
                           Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{x:Static resx:AppResources.Status}"
                                   Style="{StaticResource LabelMedium}"/>
                            <Label Text="{Binding CurrentWork.StatusCode, Converter={StaticResource WorkStatusCodeToLocalizedConverter}}"
                                   Style="{StaticResource TitleMedium}"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Wall Thickness Card -->
                    <Border Grid.Row="1" Grid.Column="0"
                           Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{x:Static resx:AppResources.WallThickness}"
                                   Style="{StaticResource LabelMedium}"/>
                            <Label Text="{Binding CurrentWork.WallThickness, StringFormat='{0} mm'}"
                                   Style="{StaticResource TitleMedium}"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Sync Status Card -->
                    <Border Grid.Row="1" Grid.Column="1"
                           Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{x:Static resx:AppResources.SyncStatus}"
                                   Style="{StaticResource LabelMedium}"/>
                            <Label Text="{Binding CurrentWork.SyncStatus, Converter={StaticResource SyncStatusCodeToLocalizedConverter}}"
                                   Style="{StaticResource TitleMedium}"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Created Date Card -->
                    <Border Grid.Row="2" Grid.Column="0"
                           Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{x:Static resx:AppResources.CreatedAt}"
                                   Style="{StaticResource LabelMedium}"/>
                            <Label Text="{Binding CurrentWork.CreatedAt, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
                                   Style="{StaticResource BodyMedium}"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Updated Date Card -->
                    <Border Grid.Row="2" Grid.Column="1"
                           Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{x:Static resx:AppResources.UpdatedAt}"
                                   Style="{StaticResource LabelMedium}"/>
                            <Label Text="{Binding CurrentWork.UpdatedAt, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
                                   Style="{StaticResource BodyMedium}"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Drying Timer Card (In Progress) -->
                <Border Style="{StaticResource InfoCardStyle}"
                       BackgroundColor="{AppThemeBinding Light={StaticResource SecondaryContainer}, Dark={StaticResource SecondaryContainerDark}}"
                       IsVisible="{Binding CurrentWork.RemainingDryingTime, Converter={StaticResource IsNotNullConverter}}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static resx:AppResources.DryingTime}"
                               Style="{StaticResource TitleMedium}"
                               TextColor="{AppThemeBinding Light={StaticResource OnSecondaryContainer}, Dark={StaticResource OnSecondaryContainerDark}}"/>
                        
                        <Label Text="{Binding CurrentWork.RemainingDryingTime, StringFormat={x:Static resx:AppResources.TimeLeft}}"
                               Style="{StaticResource HeadlineMedium}"
                               TextColor="{AppThemeBinding Light={StaticResource OnSecondaryContainer}, Dark={StaticResource OnSecondaryContainerDark}}"/>

                        <Label Text="{Binding CurrentWork.DryingStartedAt, StringFormat={x:Static resx:AppResources.DryingStartedFormat}}"
                               Style="{StaticResource Caption}"
                               TextColor="{AppThemeBinding Light={StaticResource OnSecondaryContainer}, Dark={StaticResource OnSecondaryContainerDark}}"
                               IsVisible="{Binding CurrentWork.DryingStartedAt, Converter={StaticResource IsNotNullConverter}}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Drying Completed Card -->
                <Border Style="{StaticResource InfoCardStyle}"
                       BackgroundColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                       IsVisible="{Binding CurrentWork.DryingCompletedAt, Converter={StaticResource IsNotNullConverter}}">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="✅"
                                   FontSize="24"
                                   VerticalOptions="Center"/>
                            <Label Text="{x:Static resx:AppResources.DryingCompleted}"
                                   Style="{StaticResource TitleMedium}"
                                   TextColor="{StaticResource White}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <Label Text="{Binding CurrentWork.DryingCompletedAt, StringFormat={x:Static resx:AppResources.DryingCompletedAtFormat}}"
                               Style="{StaticResource BodyMedium}"
                               TextColor="{StaticResource White}"
                               Opacity="0.9"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Action Buttons -->
                <VerticalStackLayout Spacing="12" Margin="0,8,0,0">
                    <Button Text="{x:Static resx:AppResources.ChangeStatus}"
                            IsVisible="{Binding CurrentWork.DryingCompletedAt, Converter={StaticResource IsNullConverter}}"
                            Command="{Binding ChangeStatusCommand}"
                            Style="{StaticResource PrimaryButton}"/>

                    <Button Text="{x:Static resx:AppResources.GoBack}"
                            Command="{Binding GoBackCommand}"
                            Style="{StaticResource SecondaryButton}"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
