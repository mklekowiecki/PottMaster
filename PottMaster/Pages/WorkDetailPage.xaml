<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PottMaster.ViewModels"
             xmlns:models="clr-namespace:PottMaster.Models"
             xmlns:resx="clr-namespace:PottMaster.Resources"
             x:Class="PottMaster.Pages.WorkDetailPage"
             Title="{x:Static resx:AppResources.WorkDetails}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{x:Static resx:AppResources.Delete}"
                     Command="{Binding DeleteWorkCommand}"
                     IconImageSource="delete.png"/>
    </ContentPage.ToolbarItems>

    <Grid>
        <ActivityIndicator IsRunning="{Binding IsLoading}"
                         IsVisible="{Binding IsLoading}"
                         Color="{StaticResource Primary}"
                         HeightRequest="50"
                         VerticalOptions="Center"
                         HorizontalOptions="Center"/>

        <ScrollView IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
            <VerticalStackLayout Padding="16" Spacing="24">

                <Border Padding="0"
                        BackgroundColor="{StaticResource Gray200}"
                        IsVisible="{Binding CurrentWork.PhotoPath, Converter={StaticResource IsNotNullConverter}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Image Source="{Binding CurrentWork.PhotoPath}"
                           Aspect="AspectFill"
                           HeightRequest="300"/>
                </Border>

                <Border Padding="32"
                       BackgroundColor="{StaticResource Gray100}"
                       HeightRequest="300"
                       IsVisible="{Binding CurrentWork.PhotoPath, Converter={StaticResource IsNullConverter}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout VerticalOptions="Center"
                                       HorizontalOptions="Center"
                                       Spacing="8">
                        <Label Text="?"
                               FontSize="48"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="{x:Static resx:AppResources.NoPhoto}"
                               FontSize="16"
                               TextColor="{StaticResource Gray600}"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="16"
                       BackgroundColor="{StaticResource Primary}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{x:Static resx:AppResources.WorkCode}"
                               FontSize="12"
                               TextColor="{StaticResource White}"
                               Opacity="0.8"/>
                        <Label Text="{Binding CurrentWork.Code}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"/>
                    </VerticalStackLayout>
                </Border>

                <Grid RowDefinitions="Auto,Auto,Auto,Auto" 
                      ColumnDefinitions="*,*"
                      RowSpacing="16"
                      ColumnSpacing="12">

                    <Border Grid.Row="0" Grid.Column="0"
                           Padding="12"
                           BackgroundColor="{StaticResource Gray100}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{x:Static resx:AppResources.Category}"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray600}"/>
                            <Label Text="{Binding CurrentWork.CategoryName}"
                                   FontSize="16"
                                   FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1"
                           Padding="12"
                           BackgroundColor="{StaticResource Gray100}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{x:Static resx:AppResources.Status}"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray600}"/>
                            <Label Text="{Binding CurrentWork.StatusName}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0"
                           Padding="12"
                           BackgroundColor="{StaticResource Gray100}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{x:Static resx:AppResources.WallThickness}"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray600}"/>
                            <Label Text="{Binding CurrentWork.WallThickness, StringFormat='{0} mm'}"
                                   FontSize="16"
                                   FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1"
                           Padding="12"
                           BackgroundColor="{StaticResource Gray100}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{x:Static resx:AppResources.SyncStatus}"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray600}"/>
                            <Label Text="{Binding CurrentWork.SyncStatus}"
                                   FontSize="16"
                                   FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0"
                           Padding="12"
                           BackgroundColor="{StaticResource Gray100}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{x:Static resx:AppResources.CreatedAt}"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray600}"/>
                            <Label Text="{Binding CurrentWork.CreatedAt, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
                                   FontSize="14"
                                   FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="1"
                           Padding="12"
                           BackgroundColor="{StaticResource Gray100}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{x:Static resx:AppResources.UpdatedAt}"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray600}"/>
                            <Label Text="{Binding CurrentWork.UpdatedAt, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
                                   FontSize="14"
                                   FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Padding="16"
                       BackgroundColor="{StaticResource Secondary}"
                       IsVisible="{Binding CurrentWork.RemainingDryingTime, Converter={StaticResource IsNotNullConverter}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="{x:Static resx:AppResources.DryingTime}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource White}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <Label Text="{Binding CurrentWork.RemainingDryingTime, StringFormat={x:Static resx:AppResources.TimeLeft}}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"/>

                        <Label Text="{Binding CurrentWork.DryingStartedAt, StringFormat={x:Static resx:AppResources.DryingStartedFormat}}"
                               FontSize="12"
                               TextColor="{StaticResource White}"
                               Opacity="0.8"
                               IsVisible="{Binding CurrentWork.DryingStartedAt, Converter={StaticResource IsNotNullConverter}}"/>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="16"
                       BackgroundColor="#4CAF50"
                       IsVisible="{Binding CurrentWork.DryingCompletedAt, Converter={StaticResource IsNotNullConverter}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="[Check]"
                                   FontSize="24"
                                   TextColor="{StaticResource White}"
                                   VerticalOptions="Center"/>
                            <Label Text="{x:Static resx:AppResources.DryingCompleted}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource White}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <Label Text="{Binding CurrentWork.DryingCompletedAt, StringFormat={x:Static resx:AppResources.DryingCompletedAtFormat}}"
                               FontSize="14"
                               TextColor="{StaticResource White}"
                               Opacity="0.9"/>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="12">
                    <Button Text="{x:Static resx:AppResources.ChangeStatus}"
                            Command="{Binding ChangeStatusCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource White}"
                            HeightRequest="50"
                            CornerRadius="25"
                            FontSize="16"
                            FontAttributes="Bold"/>

                    <Button Text="{x:Static resx:AppResources.GoBack}"
                            Command="{Binding GoBackCommand}"
                            BackgroundColor="{StaticResource Gray300}"
                            TextColor="{StaticResource Gray900}"
                            HeightRequest="50"
                            CornerRadius="25"
                            FontSize="16"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
