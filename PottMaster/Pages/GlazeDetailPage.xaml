<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:PottMaster.Controls"
             xmlns:resx="clr-namespace:PottMaster.Resources"
             x:Class="PottMaster.Pages.GlazeDetailPage"
             Title="{x:Static resx:AppResources.GlazeDetails}">
    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">
            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <Label Grid.Column="0" Grid.Row="0"
                       Text="{Binding Glaze.Name}"
                       FontSize="24"
                       FontAttributes="Bold"/>
                <Label Grid.Column="0" Grid.Row="1"
                       Text="{Binding Glaze.Manufacturer}"
                       FontSize="16"
                       Opacity="0.7"/>
                <Button Grid.Column="1" Grid.RowSpan="2"
                        Text="{x:Static resx:AppResources.Edit}"
                        Command="{Binding EditCommand}"
                        VerticalOptions="Center"/>
            </Grid>

            <!-- Quick Actions -->
            <HorizontalStackLayout Spacing="8">
                <Button Text="{Binding Glaze.IsFavorite, Converter={StaticResource BoolToFavoriteTextConverter}}"
                        Command="{Binding ToggleFavoriteCommand}"/>
            </HorizontalStackLayout>

            <!-- Essential Info Card -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" 
                      RowSpacing="12">
                    <Label Grid.Row="0" Grid.Column="0" Text="{x:Static resx:AppResources.TypeLabel}" FontAttributes="Bold"/>
                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Glaze.TypeName}"/>
                    
                    <Label Grid.Row="1" Grid.Column="0" Text="{x:Static resx:AppResources.ConeRatingLabel}" FontAttributes="Bold"/>
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Glaze.ConeRating}"/>
                    
                    <Label Grid.Row="2" Grid.Column="0" Text="{x:Static resx:AppResources.ColorLabel}" FontAttributes="Bold"/>
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding Glaze.Color}"/>
                    
                    <Label Grid.Row="3" Grid.Column="0" Text="{x:Static resx:AppResources.QuantityLabel}" FontAttributes="Bold"/>
                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding Glaze.Quantity}"/>
                    
                    <Label Grid.Row="4" Grid.Column="0" Text="{x:Static resx:AppResources.FoodSafeLabel}" FontAttributes="Bold"/>
                    <Label Grid.Row="4" Grid.Column="1" 
                           Text="{Binding Glaze.FoodSafe, Converter={StaticResource FoodSafeToTextConverter}}"/>
                </Grid>
            </Border>

            <!-- Collapsible Sections -->
            <controls:CollapsibleSection Title="{x:Static resx:AppResources.FiringParameters}" IsExpanded="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static resx:AppResources.TemperatureRange}" FontAttributes="Bold"/>
                    <Label Text="{Binding Glaze.Properties.Firing.TemperatureMin, StringFormat='{0} - {Binding Glaze.Properties.Firing.TemperatureMax} {Binding Glaze.Properties.Firing.TemperatureUnit}'}"/>
                    
                    <Label Text="{x:Static resx:AppResources.Atmosphere}" FontAttributes="Bold"/>
                    <Label Text="{Binding Glaze.Properties.Firing.Atmosphere}"/>
                    
                    <Label Text="{x:Static resx:AppResources.CurveSensitivity}" FontAttributes="Bold"/>
                    <Label Text="{Binding Glaze.Properties.Firing.CurveSensitivity}"/>
                </VerticalStackLayout>
            </controls:CollapsibleSection>

            <controls:CollapsibleSection Title="{x:Static resx:AppResources.AppearanceProperties}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static resx:AppResources.Transparency}" FontAttributes="Bold"/>
                    <Label Text="{Binding Glaze.Properties.Appearance.Transparency}"/>
                    
                    <Label Text="{x:Static resx:AppResources.Finish}" FontAttributes="Bold"/>
                    <Label Text="{Binding Glaze.Properties.Appearance.Finish}"/>
                </VerticalStackLayout>
            </controls:CollapsibleSection>

            <controls:CollapsibleSection Title="{x:Static resx:AppResources.GlazeBehavior}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static resx:AppResources.MeltFluidity}" FontAttributes="Bold"/>
                    <Label Text="{Binding Glaze.Properties.Behavior.MeltFluidity}"/>
                    
                    <Label Text="{x:Static resx:AppResources.ThicknessTolerance}" FontAttributes="Bold"/>
                    <Label Text="{Binding Glaze.Properties.Behavior.ThicknessTolerance}"/>
                    
                    <Label Text="{x:Static resx:AppResources.ColorStability}" FontAttributes="Bold"/>
                    <Label Text="{Binding Glaze.Properties.Behavior.ColorStability}"/>
                </VerticalStackLayout>
            </controls:CollapsibleSection>

            <controls:CollapsibleSection Title="{x:Static resx:AppResources.ApplicationDetails}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static resx:AppResources.Form}" FontAttributes="Bold"/>
                    <Label Text="{Binding Glaze.Properties.Application.Form}"/>
                    
                    <Label Text="{x:Static resx:AppResources.RecommendedThicknessExample}" FontAttributes="Bold"/>
                    <Label Text="{Binding Glaze.Properties.Application.RecommendedThickness}"/>
                    
                    <Label Text="{x:Static resx:AppResources.ApplicationNotes}" FontAttributes="Bold"/>
                    <Label Text="{Binding Glaze.Properties.Application.ApplicationNotes}" LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </controls:CollapsibleSection>

            <controls:CollapsibleSection Title="{x:Static resx:AppResources.AdvancedProperties}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static resx:AppResources.ClayInteraction}" FontAttributes="Bold"/>
                    <Label Text="{Binding Glaze.Properties.Advanced.ClayInteraction}"/>
                    
                    <Label Text="{x:Static resx:AppResources.WorkType}" FontAttributes="Bold"/>
                    <Label Text="{Binding Glaze.Properties.Advanced.WorkType}"/>
                    
                    <Label Text="{x:Static resx:AppResources.Durability}" FontAttributes="Bold"/>
                    <Label Text="{Binding Glaze.Properties.Advanced.Durability}"/>
                    
                    <Label Text="{x:Static resx:AppResources.MitigationNotes}" FontAttributes="Bold"/>
                    <Label Text="{Binding Glaze.Properties.Advanced.MitigationNotes}" LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </controls:CollapsibleSection>

            <!-- Notes Section -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                    IsVisible="{Binding Glaze.Notes, Converter={StaticResource IsNotNullConverter}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8" Padding="16">
                    <Label Text="{x:Static resx:AppResources.Notes}" FontAttributes="Bold" FontSize="16"/>
                    <Label Text="{Binding Glaze.Notes}" LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Border>

            <!-- Delete Button -->
            <Button Text="{x:Static resx:AppResources.DeleteGlaze}"
                    Command="{Binding DeleteCommand}"
                    BackgroundColor="Red"
                    Margin="0,24,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
