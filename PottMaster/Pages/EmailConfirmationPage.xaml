<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:resx="clr-namespace:PottMaster.Resources"
             x:Class="PottMaster.Pages.EmailConfirmationPage"
             Title="{x:Static resx:AppResources.EmailConfirmationTitle}">
    <VerticalStackLayout
        Spacing="25"
        Padding="30,0"
        VerticalOptions="Center">

        <ActivityIndicator
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}" />

        <Label
            Text="{Binding StatusMessage}"
            FontSize="16"
            HorizontalOptions="Center" />

        <Button
            Text="{x:Static resx:AppResources.GoToLogin}"
            Command="{Binding GoToLoginCommand}"
            IsVisible="{Binding IsSuccess}" />

    </VerticalStackLayout>
</ContentPage>