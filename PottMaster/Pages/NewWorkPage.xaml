<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PottMaster.ViewModels"
             xmlns:models="clr-namespace:PottMaster.Models"
             xmlns:resources="clr-namespace:PottMaster.Resources;assembly=PottMaster"
             x:Class="PottMaster.Pages.NewWorkPage"
             x:DataType="vm:NewWorkViewModel"
             Title="{x:Static resources:AppResources.NewWorkPage}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{x:Static resources:AppResources.Cancel}"
                     Command="{Binding CancelCommand}"/>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="24">
            
            <!-- Error Message -->
            <Frame IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                   BackgroundColor="{StaticResource Secondary}"
                   Padding="12"
                   CornerRadius="8"
                   BorderColor="{StaticResource Primary}">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource White}"
                       FontSize="14"/>
            </Frame>

            <!-- Photo Section -->
            <VerticalStackLayout Spacing="12">
                <Label Text="{x:Static resources:AppResources.PhotoTitle}"
                       FontSize="18"
                       FontAttributes="Bold"/>
                
                <!-- Photo Preview -->
                <Frame Padding="0"
                       CornerRadius="12"
                       IsClippedToBounds="True"
                       BackgroundColor="{StaticResource Gray200}"
                       HeightRequest="300"
                       IsVisible="{Binding PhotoPath, Converter={StaticResource IsNotNullConverter}}">
                    <Image Source="{Binding PhotoPath}"
                           Aspect="AspectFill"/>
                </Frame>

                <!-- Empty State -->
                <Frame Padding="32"
                       CornerRadius="12"
                       BackgroundColor="{StaticResource Gray100}"
                       HeightRequest="300"
                       IsVisible="{Binding PhotoPath, Converter={StaticResource IsNullConverter}}">
                    <VerticalStackLayout VerticalOptions="Center"
                                       HorizontalOptions="Center"
                                       Spacing="8">
                        <Label Text="??"
                               FontSize="48"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="{x:Static resources:AppResources.NoPhotoSelected}"
                               FontSize="16"
                               TextColor="{StaticResource Gray600}"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Photo Buttons -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Grid.Column="0"
                            Text="{x:Static resources:AppResources.TakePhoto}"
                            Command="{Binding TakePhotoCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource White}"/>
                    <Button Grid.Column="1"
                            Text="{x:Static resources:AppResources.PickPhoto}"
                            Command="{Binding PickPhotoCommand}"
                            BackgroundColor="{StaticResource Secondary}"
                            TextColor="{StaticResource White}"/>
                </Grid>
            </VerticalStackLayout>

            <!-- Category Section -->
            <VerticalStackLayout Spacing="12">
                <Label Text="{x:Static resources:AppResources.CategoryTitle}"
                       FontSize="18"
                       FontAttributes="Bold"/>
                
                <Picker Title="{x:Static resources:AppResources.SelectCategory}"
                        ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory}"
                        FontSize="16"
                        BackgroundColor="{StaticResource White}">
                    <Picker.ItemDisplayBinding>
                        <Binding Path="Code" Converter="{StaticResource WorkCategoryCodeToLocalizedConverter}"/>
                    </Picker.ItemDisplayBinding>
                </Picker>
            </VerticalStackLayout>

            <!-- Wall Thickness Section -->
            <VerticalStackLayout Spacing="12">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="{x:Static resources:AppResources.WallThicknessTitle}"
                           FontSize="18"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>
                    <Label Text="{Binding WallThickness, StringFormat='{0:F0} mm'}"
                           FontSize="16"
                           TextColor="{StaticResource Primary}"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <Slider Minimum="3"
                        Maximum="50"
                        Value="{Binding WallThickness}"
                        MinimumTrackColor="{StaticResource Primary}"
                        MaximumTrackColor="{StaticResource Gray300}"
                        ThumbColor="{StaticResource Primary}"/>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                    <Label Grid.Column="0"
                           Text="{x:Static resources:AppResources.ThinWallLabel}"
                           FontSize="12"
                           TextColor="{StaticResource Gray600}"
                           HorizontalOptions="Start"/>
                    <Label Grid.Column="1"
                           Text="{x:Static resources:AppResources.MidWallLabel}"
                           FontSize="12"
                           TextColor="{StaticResource Gray600}"
                           HorizontalOptions="Center"/>
                    <Label Grid.Column="2"
                           Text="{x:Static resources:AppResources.ThickWallLabel}"
                           FontSize="12"
                           TextColor="{StaticResource Gray600}"
                           HorizontalOptions="End"/>
                </Grid>

                <!-- Drying Time Estimate -->
                <Border Padding="12"
                       BackgroundColor="{StaticResource Gray100}">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="??"
                               FontSize="20"
                               VerticalOptions="Center"/>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{x:Static resources:AppResources.EstimatedDryingTimeLabel}"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray600}"/>
                            <Label Text="{Binding WallThickness, Converter={StaticResource WallThicknessToDaysConverter}}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Save Button -->
            <Button Text="{x:Static resources:AppResources.CreateWork}"
                    Command="{Binding SaveWorkCommand}"
                    IsEnabled="{Binding IsSaveEnabled, Mode=TwoWay}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource White}"
                    HeightRequest="56"
                    CornerRadius="28"
                    FontSize="18"
                    FontAttributes="Bold"
                    Margin="0,16,0,0">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                Binding="{Binding IsSaving}"
                                Value="True">
                        <Setter Property="Text" Value="{x:Static resources:AppResources.CreatingWork}"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                             IsVisible="{Binding IsLoading}"
                             Color="{StaticResource Primary}"
                             HeightRequest="50"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
