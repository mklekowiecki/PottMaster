<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PottMaster.ViewModels"
             xmlns:models="clr-namespace:PottMasterLib.Models;assembly=PottMasterLib"
             xmlns:resources="clr-namespace:PottMaster.Resources;assembly=PottMaster"
             x:Class="PottMaster.Pages.NewWorkPage"
             x:DataType="vm:NewWorkViewModel"
             Title="{x:Static resources:AppResources.NewWorkPage}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{x:Static resources:AppResources.Cancel}"
                     Command="{Binding CancelCommand}"/>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="0">

            <!-- Error Message -->
            <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                   BackgroundColor="{AppThemeBinding Light={StaticResource ErrorContainer}, Dark={StaticResource ErrorContainerDark}}"
                   StrokeThickness="0"
                   Padding="16,12"
                   Margin="0,0,0,24">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <Label Text="{Binding ErrorMessage}"
                       Style="{StaticResource BodyMedium}"
                       TextColor="{AppThemeBinding Light={StaticResource OnErrorContainer}, Dark={StaticResource OnErrorContainerDark}}"/>
            </Border>

            <!-- Photo Section -->
            <VerticalStackLayout Style="{StaticResource SectionContainer}">
                <Label Text="{x:Static resources:AppResources.PhotoTitle}"
                       Style="{StaticResource SectionHeader}"/>

                <!-- Photos Collection -->
                <CollectionView ItemsSource="{Binding Photos}"
                               HeightRequest="200"
                               IsVisible="{Binding HasPhotos}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:LocalPhoto">
                            <Border Style="{StaticResource CardStyle}"
                                   Padding="0"
                                   HeightRequest="200"
                                   WidthRequest="200">
                                <Image Source="{Binding Path, Converter={StaticResource StringToImageSourceConverter}}"
                                       Aspect="AspectFill"/>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Empty State -->
                <Border Style="{StaticResource CardStyle}"
                       BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceVariant}, Dark={StaticResource SurfaceVariantDark}}"
                       HeightRequest="200"
                       IsVisible="{Binding HasPhotos, Converter={StaticResource InvertedBoolConverter}}">
                    <VerticalStackLayout VerticalOptions="Center"
                                        HorizontalOptions="Center"
                                        Spacing="8">
                        <Label Text="📷"
                               FontSize="48"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="{x:Static resources:AppResources.NoPhoto}"
                               Style="{StaticResource BodyLarge}"
                               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Photo Buttons -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Grid.Column="0"
                            Text="{x:Static resources:AppResources.TakePhoto}"
                            Command="{Binding TakePhotoCommand}"
                            Style="{StaticResource PrimaryButton}"/>
                    <Button Grid.Column="1"
                            Text="{x:Static resources:AppResources.PickPhoto}"
                            Command="{Binding PickPhotoCommand}"
                            Style="{StaticResource SecondaryButton}"/>
                </Grid>
            </VerticalStackLayout>

            <!-- Details Section -->
            <VerticalStackLayout Style="{StaticResource SectionContainer}">
                <Label Text="{x:Static resources:AppResources.CategoryTitle}"
                       Style="{StaticResource SectionHeader}"/>

                <Picker Title="{x:Static resources:AppResources.SelectCategory}"
                        ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory}"
                        Style="{StaticResource PrimaryPicker}">
                    <Picker.ItemDisplayBinding>
                        <Binding Path="Code" Converter="{StaticResource WorkCategoryCodeToLocalizedConverter}"/>
                    </Picker.ItemDisplayBinding>
                </Picker>

                <Label Text="{x:Static resources:AppResources.WorkCode}"
                       Style="{StaticResource SectionHeader}"
                       Margin="0,16,0,8"/>

                <Entry Text="{Binding WorkCode}"
                       Placeholder="{x:Static resources:AppResources.EnterWorkCode}"
                       Style="{StaticResource PrimaryEntry}"/>
            </VerticalStackLayout>

            <!-- Wall Thickness Section -->
            <VerticalStackLayout Style="{StaticResource SectionContainer}">
                <HorizontalStackLayout Spacing="8" Margin="0,0,0,16">
                    <Label Text="{x:Static resources:AppResources.WallThicknessTitle}"
                           Style="{StaticResource SectionHeader}"
                           VerticalOptions="Center"
                           Margin="0"/>
                    <Label Text="{Binding WallThickness, StringFormat='{0:F0} mm'}"
                           Style="{StaticResource TitleMedium}"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <Slider Minimum="3"
                        Maximum="50"
                        Value="{Binding WallThickness}"
                        Margin="0,0,0,8"/>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4" Margin="0,0,0,16">
                    <Label Grid.Column="0"
                           Text="{x:Static resources:AppResources.ThinWallLabel}"
                           Style="{StaticResource Caption}"
                           HorizontalOptions="Start"/>
                    <Label Grid.Column="1"
                           Text="{x:Static resources:AppResources.MidWallLabel}"
                           Style="{StaticResource Caption}"
                           HorizontalOptions="Center"/>
                    <Label Grid.Column="2"
                           Text="{x:Static resources:AppResources.ThickWallLabel}"
                           Style="{StaticResource Caption}"
                           HorizontalOptions="End"/>
                </Grid>

                <!-- Drying Time Estimate -->
                <Border Style="{StaticResource InfoCardStyle}">
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="⏱️"
                               FontSize="24"
                               VerticalOptions="Center"/>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{x:Static resources:AppResources.EstimatedDryingTimeLabel}"
                                   Style="{StaticResource LabelMedium}"
                                   TextColor="{AppThemeBinding Light={StaticResource OnPrimaryContainer}, Dark={StaticResource OnPrimaryContainerDark}}"/>
                            <Label Text="{Binding WallThickness, Converter={StaticResource WallThicknessToDaysConverter}}"
                                   Style="{StaticResource TitleMedium}"
                                   TextColor="{AppThemeBinding Light={StaticResource OnPrimaryContainer}, Dark={StaticResource OnPrimaryContainerDark}}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Actions Section -->
            <VerticalStackLayout Spacing="16" Margin="0,16,0,0">
                <!-- Save Button -->
                <Button Text="{x:Static resources:AppResources.CreateWork}"
                        Command="{Binding SaveWorkCommand}"
                        IsEnabled="{Binding IsSaveEnabled, Mode=TwoWay}"
                        Style="{StaticResource PrimaryButton}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                    Binding="{Binding IsSaving}"
                                    Value="True">
                            <Setter Property="Text" Value="{x:Static resources:AppResources.CreatingWork}"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <!-- Loading Indicator -->
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                 IsVisible="{Binding IsLoading}"
                                 HeightRequest="50"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
