<ContentPage x:Class="PottMaster.LoginPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Logowanie">
    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="30,0" VerticalOptions="Center">
            <Label Text="PottMaster" SemanticProperties.HeadingLevel="Level1" Style="{StaticResource HeadingLabel}" />
            <Label Text="Witamy ponownie!" FontSize="32" HorizontalOptions="Center" />
            <Entry Placeholder="Nazwa użytkownika" Text="{Binding Email, Mode=TwoWay}" Style="{StaticResource ModernEntry}" />
            <Entry Placeholder="Hasło" Text="{Binding Password, Mode=TwoWay}" IsPassword="true" Style="{StaticResource ModernEntry}" />
            <Button Text="Zaloguj się" Command="{Binding LoginCommand}" IsEnabled="{Binding IsLoginEnabled}" SemanticProperties.Hint="Logs the user in" />
            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="Gray" HorizontalOptions="Center" />
            <Label Text="Nie masz konta?" HorizontalOptions="Center" Opacity="0.6" />
            <Button Text="Zarejestruj się" Command="{Binding SignupCommand}" SemanticProperties.Hint="Redirects to sign up page" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>