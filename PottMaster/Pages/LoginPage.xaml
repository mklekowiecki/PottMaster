<ContentPage x:Class="PottMaster.LoginPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:resx="clr-namespace:PottMaster.Resources"
             Title="{x:Static resx:AppResources.Login}">
    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="30,0" VerticalOptions="Center">
            <Label Text="PottMaster" SemanticProperties.HeadingLevel="Level1" Style="{StaticResource HeadingLabel}" />
            <Label Text="{x:Static resx:AppResources.WelcomeBack}" FontSize="32" HorizontalOptions="Center" />
            <Entry Placeholder="{x:Static resx:AppResources.Username}" Text="{Binding Email, Mode=TwoWay}" Style="{StaticResource ModernEntry}" />
            <Entry Placeholder="{x:Static resx:AppResources.Password}" Text="{Binding Password, Mode=TwoWay}" IsPassword="true" Style="{StaticResource ModernEntry}" />
            <Button Text="{x:Static resx:AppResources.Login}" Command="{Binding LoginCommand}" IsEnabled="{Binding IsLoginEnabled}" SemanticProperties.Hint="{x:Static resx:AppResources.LoginHint}" />
            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="Gray" HorizontalOptions="Center" />
            <Label Text="{x:Static resx:AppResources.NoAccount}" HorizontalOptions="Center" Opacity="0.6" />
            <Button Text="{x:Static resx:AppResources.Signup}" Command="{Binding SignupCommand}" SemanticProperties.Hint="{x:Static resx:AppResources.SignUpHint}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>