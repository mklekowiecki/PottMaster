<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:PottMaster.Controls"
             x:Class="PottMaster.Pages.WikiPage"
             Title="Wiki">

    <Grid RowDefinitions="*,Auto">
        <VerticalStackLayout Grid.Row="0" Padding="24" 
                           Spacing="16"
                           VerticalOptions="Center"
                           HorizontalOptions="Center">
            <Label Text="Knowledge Base"
                   Style="{StaticResource HeadlineLarge}"
                   HorizontalOptions="Center"/>
            <Label Text="Coming Soon"
                   Style="{StaticResource BodyLarge}"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"/>
            <Label Text="Browse community-verified information about ceramic materials, tools, and techniques."
                   Style="{StaticResource BodyMedium}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,16,0,0"
                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"/>
        </VerticalStackLayout>

        <!-- Bottom Navigation Bar -->
        <controls:BottomNavigationBar Grid.Row="1" />
    </Grid>

</ContentPage>
