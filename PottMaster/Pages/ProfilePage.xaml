<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PottMaster.ViewModels"
             xmlns:resx="clr-namespace:PottMaster.Resources"
             x:Class="PottMaster.Pages.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Profile">

    <Grid>
        <!-- Loading Indicator -->
        <ActivityIndicator IsRunning="{Binding IsLoading}"
                         IsVisible="{Binding IsLoading}"
                         HeightRequest="50"
                         VerticalOptions="Center"
                         HorizontalOptions="Center"/>

        <!-- Profile Content -->
        <ScrollView IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
            <VerticalStackLayout Padding="24" Spacing="0">

                <!-- Profile Header -->
                <VerticalStackLayout Spacing="16" Margin="0,24,0,32">
                    <!-- User Avatar (Initials) -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                           StrokeThickness="0"
                           HeightRequest="100"
                           WidthRequest="100"
                           HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="50"/>
                        </Border.StrokeShape>
                        <Label Text="{Binding UserInitials}"
                               Style="{StaticResource DisplayMedium}"
                               TextColor="{AppThemeBinding Light={StaticResource OnPrimary}, Dark={StaticResource OnPrimaryDark}}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <!-- User Email -->
                    <Label Text="{Binding UserEmail}"
                           Style="{StaticResource BodyLarge}"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"/>
                </VerticalStackLayout>

                <!-- Account Settings Section -->
                <VerticalStackLayout Style="{StaticResource SectionContainer}">
                    <Label Text="Account Settings"
                           Style="{StaticResource SectionHeader}"/>

                    <!-- Initials Display -->
                    <Border Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Initials"
                                   Style="{StaticResource LabelLarge}"/>
                            <Label Text="{Binding UserInitials}"
                                   Style="{StaticResource BodyLarge}"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- About Section -->
                <VerticalStackLayout Style="{StaticResource SectionContainer}">
                    <Label Text="About"
                           Style="{StaticResource SectionHeader}"/>

                    <!-- Version Info -->
                    <Border Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Version"
                                   Style="{StaticResource LabelLarge}"/>
                            <Label Text="{Binding AppVersion}"
                                   Style="{StaticResource BodyLarge}"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Danger Zone Section -->
                <VerticalStackLayout Style="{StaticResource SectionContainer}">
                    <Label Text="Danger Zone"
                           Style="{StaticResource SectionHeader}"
                           TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"/>

                    <!-- Logout Button -->
                    <Button Text="Logout"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource SecondaryButton}"
                            BorderColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
