<ContentPage x:Class="PottMaster.SignupPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Sign Up">
    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="30,0" VerticalOptions="Center">
            <Image Source="dotnet_bot.png" SemanticProperties.Description="Słodki bot .NET machający do Ciebie!" 
                   HeightRequest="200" HorizontalOptions="Center" />
            <Label Text="Witaj, Świecie!" SemanticProperties.HeadingLevel="Level1" Style="{StaticResource HeadingLabel}" />
            <Label Text="Utwórz nowe konto" SemanticProperties.HeadingLevel="Level2" Style="{StaticResource SubheadingLabel}" />
            <Entry Placeholder="Email" Text="{Binding Email, Mode=TwoWay}" Style="{StaticResource ModernEntry}" />
            <Entry Placeholder="Hasło" Text="{Binding Password, Mode=TwoWay}" IsPassword="true" Style="{StaticResource ModernEntry}" />
            <Button Text="Zarejestruj się" Command="{Binding SignupCommand}" IsEnabled="{Binding IsSignupEnabled}" SemanticProperties.Hint="Tworzy nowe konto użytkownika" />
            <Label Text="Masz już konto? Zaloguj się" 
                   HorizontalOptions="Center" Opacity="0.6" />
            <Button Text="Zaloguj się" Command="{Binding NavigateToLoginCommand}" SemanticProperties.Hint="Przekierowuje do strony logowania" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>