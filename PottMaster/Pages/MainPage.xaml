<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PottMaster.ViewModels"
             xmlns:models="clr-namespace:PottMaster.Models"
             x:Class="PottMaster.MainPage"
             x:DataType="vm:MainViewModel"
             Title="My Works">

    <Grid RowDefinitions="*,Auto">
        <!-- Works List -->
        <RefreshView Grid.Row="0" 
                     Command="{Binding LoadWorksCommand}"
                     IsRefreshing="{Binding IsLoading}">
            <ScrollView>
                <VerticalStackLayout Padding="16" Spacing="12">
                    
                    <!-- Empty State -->
                    <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center"
                                       Spacing="16"
                                       Padding="32">
                        <Label Text="No works yet"
                               FontSize="24"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Start by adding your first ceramic work"
                               FontSize="16"
                               TextColor="{StaticResource Gray600}"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                    <!-- Works Collection -->
                    <CollectionView ItemsSource="{Binding Works}"
                                  IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Work">
                                <Frame Padding="12" 
                                       Margin="0,0,0,8"
                                       CornerRadius="8"
                                       BorderColor="{StaticResource Gray200}">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=ViewWorkDetailsCommand}"
                                                            CommandParameter="{Binding .}"/>
                                    </Frame.GestureRecognizers>
                                    
                                    <Grid ColumnDefinitions="80,*,Auto" ColumnSpacing="12">
                                        <!-- Photo Thumbnail -->
                                        <Frame Grid.Column="0" 
                                               Padding="0"
                                               CornerRadius="8"
                                               IsClippedToBounds="True"
                                               BackgroundColor="{StaticResource Gray200}">
                                            <Image Source="{Binding PhotoPath}"
                                                   Aspect="AspectFill"
                                                   HeightRequest="80"
                                                   WidthRequest="80"/>
                                        </Frame>

                                        <!-- Work Info -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Label Text="{Binding Code}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"/>
                                            <Label Text="{Binding CategoryName}"
                                                   FontSize="14"
                                                   TextColor="{StaticResource Gray600}"/>
                                            <Label Text="{Binding StatusName}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource Primary}"/>
                                            <Label Text="{Binding RemainingDryingTime, StringFormat='Time left: {0:d\\d\\ h\\h\\ m\\m}'}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource Gray500}"/>
                                        </VerticalStackLayout>

                                        <!-- Chevron -->
                                        <Label Grid.Column="2"
                                               Text="›"
                                               FontSize="24"
                                               TextColor="{StaticResource Gray400}"
                                               VerticalOptions="Center"/>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Add Work Button -->
        <Button Grid.Row="1"
                Text="Add New Work"
                Command="{Binding AddWorkCommand}"
                Margin="16"
                HeightRequest="56"
                CornerRadius="28"
                FontSize="18"
                FontAttributes="Bold"/>
    </Grid>

</ContentPage>
