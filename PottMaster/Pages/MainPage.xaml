<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PottMaster.ViewModels"
             xmlns:models="clr-namespace:PottMasterLib.Models;assembly=PottMasterLib"
             xmlns:resx="clr-namespace:PottMaster.Resources"
             xmlns:controls="clr-namespace:PottMaster.Controls"
             x:Class="PottMaster.MainPage"
             x:DataType="vm:MainViewModel"
             Title="{x:Static resx:AppResources.MyWorks}">

    <Grid RowDefinitions="*,Auto">
        <!-- Works List -->
        <RefreshView Grid.Row="0" 
                     Command="{Binding LoadWorksCommand}"
                     IsRefreshing="{Binding IsLoading}">
            <ScrollView>
                <VerticalStackLayout Padding="16" Spacing="0">
                    
                    <!-- Empty State -->
                    <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center"
                                       Spacing="16"
                                       Padding="48">
                        <Label Text="{x:Static resx:AppResources.NoWorksYet}"
                               Style="{StaticResource HeadlineMedium}"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="{x:Static resx:AppResources.StartByAddingWork}"
                               Style="{StaticResource BodyLarge}"
                               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"
                               HorizontalTextAlignment="Center"
                               Opacity="0.7"/>
                    </VerticalStackLayout>

                    <!-- Works Collection -->
                    <CollectionView ItemsSource="{Binding Works}"
                                  IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:LocalWork">
                                <Border Style="{StaticResource CardStyle}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=ViewWorkDetailsCommand}"
                                                            CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    
                                    <Grid ColumnDefinitions="80,*,Auto" ColumnSpacing="12">
                                        <!-- Photo Thumbnail -->
                                        <Border Grid.Column="0" 
                                               Padding="0"
                                               StrokeThickness="0"
                                               BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceVariant}, Dark={StaticResource SurfaceVariantDark}}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8"/>
                                            </Border.StrokeShape>
                                            <Image Source="{Binding PhotoPath}"
                                                   Aspect="AspectFill"
                                                   HeightRequest="80"
                                                   WidthRequest="80"/>
                                        </Border>

                                        <!-- Work Info -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                            <Label Text="{Binding Code}"
                                                   Style="{StaticResource TitleMedium}"/>
                                            <Label Text="{Binding CategoryCode, Converter={StaticResource WorkCategoryCodeToLocalizedConverter}}"
                                                   Style="{StaticResource BodyMedium}"
                                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"/>
                                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryContainer}, Dark={StaticResource PrimaryContainerDark}}"
                                                   Padding="8,4"
                                                   StrokeThickness="0"
                                                   HorizontalOptions="Start">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="4"/>
                                                </Border.StrokeShape>
                                                <Label Text="{Binding StatusCode, Converter={StaticResource WorkStatusCodeToLocalizedConverter}}"
                                                       Style="{StaticResource LabelMedium}"
                                                       TextColor="{AppThemeBinding Light={StaticResource OnPrimaryContainer}, Dark={StaticResource OnPrimaryContainerDark}}"/>
                                            </Border>
                                            <Label Text="{Binding RemainingDryingTime, StringFormat={x:Static resx:AppResources.TimeLeft}}"
                                                   Style="{StaticResource Caption}"/>
                                        </VerticalStackLayout>

                                        <!-- Chevron -->
                                        <Label Grid.Column="2"
                                               Text="›"
                                               FontSize="28"
                                               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}"
                                               Opacity="0.5"
                                               VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- FAB Button -->
        <Button Grid.Row="0"
                ImageSource="add_svgrepo_com.png"
                Command="{Binding AddWorkCommand}"
                Style="{StaticResource FABButton}"
                Margin="16"
                HorizontalOptions="End"
                VerticalOptions="End"/>

        <!-- Bottom Navigation Bar -->
        <controls:BottomNavigationBar Grid.Row="1" />
    </Grid>

</ContentPage>
