<ContentPage x:Class="PottMaster.SignupPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Sign Up">
    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="30,0" VerticalOptions="Center">
            <Image Source="dotnet_bot.png" SemanticProperties.Description="Cute dot net bot waving hi to you!" 
                   HeightRequest="200" HorizontalOptions="Center" />
            <Label Text="Hello, World!" SemanticProperties.HeadingLevel="Level1" 
                   FontSize="32" HorizontalOptions="Center" />
            <Label Text="Create a new account" 
                   SemanticProperties.HeadingLevel="Level2" 
                   FontSize="18" HorizontalOptions="Center" Opacity="0.6" />
            <Entry Placeholder="Email" Text="{Binding Email, Mode=TwoWay}" TextColor="Black" />
            <Entry Placeholder="Password" Text="{Binding Password, Mode=TwoWay}" IsPassword="true" TextColor="Black" />
            <Button Text="Sign Up" Command="{Binding SignupCommand}" IsEnabled="{Binding IsSignupEnabled}" SemanticProperties.Hint="Creates a new user account" />
            <Label Text="Already have an account? Log in" 
                   HorizontalOptions="Center" Opacity="0.6" />
            <Button Text="Log In" Command="{Binding NavigateToLoginCommand}" SemanticProperties.Hint="Redirects to login page" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>