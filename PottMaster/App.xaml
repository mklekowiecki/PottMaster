<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PottMaster"
             xmlns:converters="clr-namespace:PottMaster.Converters"
             x:Class="PottMaster.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Converters -->
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
            <converters:IsNullConverter x:Key="IsNullConverter"/>
            <converters:IsNotNullConverter x:Key="IsNotNullConverter"/>
            <converters:WallThicknessToDaysConverter x:Key="WallThicknessToDaysConverter"/>
            <converters:WorkCategoryCodeToLocalizedConverter x:Key="WorkCategoryCodeToLocalizedConverter"/>
            <converters:WorkStatusCodeToLocalizedConverter x:Key="WorkStatusCodeToLocalizedConverter"/>
            <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter"/>
            <converters:SyncStatusCodeToLocalizedConverter x:Key="SyncStatusCodeToLocalizedConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
